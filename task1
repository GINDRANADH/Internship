        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "\n",
        "# Load dataset\n",
        "df = pd.read_excel('global_superstore_2016.xlsx', sheet_name='Orders')\n",
        "df['Order Date'] = pd.to_datetime(df['Order Date'])\n",
        "df['Year'] = df['Order Date'].dt.year\n",
        "df['Month'] = df['Order Date'].dt.month\n",
        "\n",
        "# Set plotting style\n",
        "sns.set_theme(style=\"whitegrid\")\n",
        "fig, axes = plt.subplots(2, 2, figsize=(15, 11))\n",
        "\n",
        "# 1. Top 10 Sub-Categories\n",
        "subcat = df.groupby(['Category', 'Sub-Category'])['Sales'].sum().reset_index().sort_values(by='Sales', ascending=False).head(10)\n",
        "sns.barplot(data=subcat, x='Sales', y='Sub-Category', hue='Category', ax=axes[0, 0], dodge=False)\n",
        "axes[0, 0].set_title('Top 10 Sub-Categories by Revenue', fontweight='bold')\n",
        "axes[0, 0].xaxis.set_major_formatter('${x:,.0f}')\n",
        "\n",
        "# 2. Top 8 Regions\n",
        "regions = df.groupby('Region')['Sales'].sum().reset_index().sort_values(by='Sales', ascending=False).head(8)\n",
        "sns.barplot(data=regions, x='Sales', y='Region', ax=axes[0, 1], palette='crest')\n",
        "axes[0, 1].set_title('Top 8 Regions by Revenue', fontweight='bold')\n",
        "axes[0, 1].xaxis.set_major_formatter('${x:,.0f}')\n",
        "\n",
        "# 3. Seasonality\n",
        "monthly = df.groupby(['Year', 'Month'])['Sales'].sum().reset_index()\n",
        "sns.lineplot(data=monthly, x='Month', y='Sales', hue='Year', palette='tab10', ax=axes[1, 0], marker='o')\n",
        "axes[1, 0].set_title('Monthly Sales Seasonality (2012–2015)', fontweight='bold')\n",
        "axes[1, 0].set_xticks(range(1, 13))\n",
        "axes[1, 0].yaxis.set_major_formatter('${x:,.0f}')\n",
        "\n",
        "# 4. Profitability / Loss Analysis\n",
        "losses = df.groupby('Sub-Category')['Profit'].sum().reset_index().sort_values(by='Profit').head(5)\n",
        "sns.barplot(data=losses, x='Profit', y='Sub-Category', ax=axes[1, 1], palette='Reds_r')\n",
        "axes[1, 1].set_title('Sub-Categories Profit / Loss Analysis', fontweight='bold')\n",
        "axes[1, 1].xaxis.set_major_formatter('${x:,.0f}')\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()\n"
      ],
