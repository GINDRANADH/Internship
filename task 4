        "import pandas as pd"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "\n",
        "# 1. Load dataset\n",
        "df = pd.read_csv('Sample data (1).xlsx - Sheet1.csv')\n",
        "df.columns = df.columns.str.strip()\n",
        "\n",
        "# 2. Data Aggregations\n",
        "product_sales = df.groupby('Product').agg(Sales=('Sales', 'sum')).reset_index().sort_values(by='Sales', ascending=False)\n",
        "country_profit = df.groupby('Country').agg(Profit=('Profit', 'sum')).reset_index().sort_values(by='Profit', ascending=False)\n",
        "segment_sales = df.groupby('Segment').agg(Sales=('Sales', 'sum')).reset_index().sort_values(by='Sales', ascending=False)\n",
        "discount_profit = df.groupby('Discount Band').agg(Profit=('Profit', 'sum')).reset_index()\n",
        "\n",
        "# 3. Create 2x2 Visual Dashboard\n",
        "sns.set_theme(style=\"whitegrid\")\n",
        "fig, axes = plt.subplots(2, 2, figsize=(16, 11))\n",
        "\n",
        "# Main Dashboard Title Header\n",
        "fig.suptitle('Executive Business & Financial Analytics Dashboard', fontsize=18, fontweight='bold', y=0.98)\n",
        "\n",
        "# Chart 1: Total Sales by Product\n",
        "sns.barplot(data=product_sales, x='Product', y='Sales', palette='Blues_r', ax=axes[0, 0])\n",
        "axes[0, 0].set_title('1. Total Sales by Product ($)', fontsize=12, fontweight='bold', pad=10)\n",
        "axes[0, 0].set_xlabel('Product', fontsize=10)\n",
        "axes[0, 0].set_ylabel('Sales ($)', fontsize=10)\n",
        "axes[0, 0].tick_params(axis='x', rotation=25)\n",
        "for p in axes[0, 0].patches:\n",
        "    axes[0, 0].annotate(f\"${p.get_height()/1e6:,.1f}M\", (p.get_x() + p.get_width() / 2., p.get_height()),\n",
        "                        ha='center', va='center', xytext=(0, 5), textcoords='offset points', fontsize=9)\n",
        "\n",
        "# Chart 2: Total Profit by Country\n",
        "sns.barplot(data=country_profit, x='Country', y='Profit', palette='Greens_r', ax=axes[0, 1])\n",
        "axes[0, 1].set_title('2. Total Profit by Country ($)', fontsize=12, fontweight='bold', pad=10)\n",
        "axes[0, 1].set_xlabel('Country', fontsize=10)\n",
        "axes[0, 1].set_ylabel('Profit ($)', fontsize=10)\n",
        "axes[0, 1].tick_params(axis='x', rotation=25)\n",
        "for p in axes[0, 1].patches:\n",
        "    axes[0, 1].annotate(f\"${p.get_height()/1e6:,.2f}M\", (p.get_x() + p.get_width() / 2., p.get_height()),\n",
        "                        ha='center', va='center', xytext=(0, 5), textcoords='offset points', fontsize=9)\n",
        "\n",
        "# Chart 3: Revenue Share by Business Segment\n",
        "axes[1, 0].pie(segment_sales['Sales'], labels=segment_sales['Segment'], autopct='%1.1f%%',\n",
        "               colors=sns.color_palette('pastel'), startangle=140, explode=[0.05]*len(segment_sales))\n",
        "axes[1, 0].set_title('3. Revenue Contribution by Segment', fontsize=12, fontweight='bold', pad=10)\n",
        "\n",
        "# Chart 4: Profit Impact Across Discount Bands\n",
        "sns.barplot(data=discount_profit, x='Discount Band', y='Profit', palette='Oranges_r', ax=axes[1, 1])\n",
        "axes[1, 1].set_title('4. Profit Impact Across Discount Bands', fontsize=12, fontweight='bold', pad=10)\n",
        "axes[1, 1].set_xlabel('Discount Band', fontsize=10)\n",
        "axes[1, 1].set_ylabel('Profit ($)', fontsize=10)\n",
        "for p in axes[1, 1].patches:\n",
        "    if p.get_height() > 0:\n",
        "        axes[1, 1].annotate(f\"${p.get_height()/1e6:,.2f}M\", (p.get_x() + p.get_width() / 2., p.get_height()),\n",
        "                            ha='center', va='center', xytext=(0, 5), textcoords='offset points', fontsize=9)\n",
        "\n",
        "plt.tight_layout(rect=[0, 0, 1, 0.96])\n",
        "plt.show()"
      ],
